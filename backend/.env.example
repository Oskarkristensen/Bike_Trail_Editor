# Kopiér denne fil til backend/.env og indsæt de rigtige værdier.
# .env er gitignoreret — læg aldrig rigtige værdier i denne eksempelfil.

# Neons *pooled* connection string (værtsnavnet indeholder "-pooler").
# Den direkte string er kun til migrationer og engangsjobs.
# Hemmelig: må aldrig i git eller i en chat.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=verify-full
